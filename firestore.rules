rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // users/{uid} — one profile doc per Firebase-Auth trainee
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // progress/{docId} — one doc per (trainee, course) pair.
    // docId is "<identity>_<courseId>". For Firebase Auth trainees,
    // identity == request.auth.uid, so the existing check still applies.
    // For PIN trainees, identity == "pin_<username>" and there is no
    // Firebase Auth session to check against — see the note below.
    match /progress/{docId} {
      allow read, write: if (request.auth != null && docId.matches(request.auth.uid + '_.*'))
                          || docId.matches('pin_.*');
    }

    // workbooks/{uid} — one doc per trainee (uid or "pin_<username>")
    match /workbooks/{uid} {
      allow read, write: if (request.auth != null && request.auth.uid == uid)
                          || uid.matches('pin_.*');
    }

    // pinUsers/{username} — PIN-account registry.
    // No Firebase Auth session exists for these, so these rules can only
    // restrict document *shape*, not prove who's making the request —
    // see the note below for what this does and doesn't protect against.
    match /pinUsers/{username} {
      allow get: if true;     // needed so the client can check a pinHash on login
      allow list: if false;   // but nobody can enumerate all usernames
      allow create: if request.resource.data.keys().hasAll(['username','pinHash','track','createdAt','upgradedToUid'])
                    && request.resource.data.pinHash is string
                    && request.resource.data.pinHash.size() == 64
                    && request.resource.data.upgradedToUid == null;
      // Once created, only the upgradedToUid field may ever change —
      // this stops a request from silently rewriting someone else's
      // pinHash, username, track, or createdAt via an "update".
      allow update: if resource.data.pinHash == request.resource.data.pinHash
                    && resource.data.username == request.resource.data.username
                    && resource.data.track == request.resource.data.track
                    && resource.data.createdAt == request.resource.data.createdAt;
      allow delete: if false;
    }

    // Everything else: denied
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
